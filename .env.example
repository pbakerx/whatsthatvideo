# Copy to .env.local for local dev, and set the same values in Vercel.

# YouTube Data API v3 key (Google Cloud console > APIs & Services > Credentials).
YOUTUBE_API_KEY=

# Claude API key, for query expansion and re-ranking.
ANTHROPIC_API_KEY=

# Voice. Optional: without these the app still works with typed descriptions.
ELEVENLABS_API_KEY=
# Printed by `npm run setup:agent`.
ELEVENLABS_AGENT_ID=

# Optional tuning (defaults shown).
# ANTHROPIC_MODEL=claude-haiku-5-5
# YOUTUBE_MAX_QUERIES_PER_ROUND=3
# MAX_REFINEMENTS_PER_SESSION=5

# Read by `npm run setup:agent` only; re-run it after changing them.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_AGENT_LLM=claude-haiku-5-5
# VOICE_MAX_SECONDS=180
# VOICE_DAILY_LIMIT=100
# VOICE_CONCURRENCY_LIMIT=5
